@0 = ~онлнцхре!~
@1 = ~рШ ДНКФЕМ СБХДЕРЭ оНКХЩРХКЕМНБСЧ оЩЛ.~
@2 = ~цДЕ? цДЕ НМЮ? аШЯРПЕЕ, Ъ УНВС БЯРПЕРХРЭЯЪ Я МЕИ!~
@3 = ~нМЮ БШЬКЮ ХГ НЙМЮ БЮММНИ. рШ ОНРЕПЪК ЕЕ.~
@4 = ~ъ - ЩРН НМ, ОНРНЛС ВРН РШ - ЩРН НМ, ОНРНЛС ВРН РШ - ЩРН Ъ, Х ЛШ БЯЕ БЛЕЯРЕ.~
@5 = ~б ЩРНЛ МЕР МХЙЮЙНЦН ЯЛШЯКЮ. вРН РШ ЯЙЮГЮК?~
@6 = ~лЮКЭВХЙ, РШ АШК МЕОНЯКСЬМНИ ДЕБНВЙНИ, РШ ОНДБНДХЬЭ ЯБНХ ЬРЮМХЬЙХ.~
@7 = ~рШ Б ОНПЪДЙЕ? б РБНХУ ЯКНБЮУ ЮАЯНКЧРМН МЕР ЯЛШЯКЮ.~
@8 = ~ю ЕЯКХ ЯНКМЖЕ МЕ БШИДЕР, РШ ЯЛНФЕЬЭ ГЮЦНПЕРЭ, ЯРНЪ ОНД ЮМЦКХИЯЙХЛ ДНФДЕЛ.~
@9 = ~юМЦКХИЯЙХЛ? вРН ГМЮВХР - ЮМЦКХИЯЙХЛ? ъ МХЙНЦДЮ МЕ ЯКШЬЮК ЯКНБЮ "ЮМЦКХИЯЙХЛ". щРН - тЮЩПСМ. рШ, ЙЮФЕРЯЪ, ГЮАКСДХКЯЪ.~
@10 = ~вЕКНБЕЙ, РШ МЮБЕПМЪЙЮ БХДХЬЭ, ЙЮЙ НМХ ОХМЮЧР щДЦЮПЮ юККЮМЮ оН.~
@11 = ~вРН... йРН... вРН РЮЙНЕ щДЦЮП юККЮМ оН? яЙЮФХ УНРЭ ВРН-МХАСДЭ НЯЛШЯКЕММНЕ.~
@12 = ~ъ ЛНПФ.~
@13 = ~рШ ЛНПФ. ъ ДСЛЮК, ВРН ЛНПФНЛ АШК оНК?~
@14 = ~оНКЕГМШИ МЕЦНДЪИ.~
@15 = ~щИ <CHARNAME>, ОНВЕЛС РШ САХК? <CHARNAME>? щИ <CHARNAME>, ОНВЕЛС РШ САХК? <CHARNAME>?~
@16 = ~гДЕЯЭ рЕМЕБШЕ бНПШ Б БЮММНИ, РНКЭЙН МХФЕ КЕЯРМХЖШ.~
